<configuration>

    <appender name="CONSOLE"
              class="ch.qos.logback.core.ConsoleAppender">

        <encoder>
            <pattern>
                %d{yyyy-MM-dd HH:mm:ss} %highlight(%-5level) [%cyan(%thread)] %green(%logger{36}) - %msg%n
            </pattern>
        </encoder>

    </appender>


    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
    </root>

</configuration>
