<?xml version="1.0" encoding="UTF-8"?>
<FindBugsFilter>
    <!-- SpotBugs exclusion filter for the Veil project.
         Per check-clean.sh, exclusions are diff-scoped to added lines only, so this
         file captures only genuine false positives - patterns SpotBugs commonly
         misreads in this codebase's context (e.g. Swing ActionListener patterns).
         No exclusion is added speculatively; each entry must be justified by a
         real finding on a committed line. -->

    <!-- GamePanel's constructor takes the Player and WorldScene it will simulate and
         render. Storing those references is the point of constructor injection:
         GamePanel owns the player and scene it is given (and replaces them itself in
         resetState), so nothing is being leaked. Scoped to the constructor only. -->
    <Match>
        <Class name="com.swiftfaze.veil.game.GamePanel"/>
        <Method name="&lt;init&gt;"/>
        <Bug pattern="EI_EXPOSE_REP2"/>
    </Match>
</FindBugsFilter>
